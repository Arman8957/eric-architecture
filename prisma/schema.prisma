// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  //  output   = "../node_modules/.prisma/client" 
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  FINANCE
  HIGHER_MANAGER
  PROJECT_MANAGER
  DRAFTER
  EMPLOYEE
  USER
  MEDIA_MANAGER
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ProposalType {
  NORMAL
  AMENDMENT
}

enum StageStatus {
  NOT_STARTED
  IN_PROGRESS
  INQUIRY
  ACTIVE
  BIDDING
  COMPLETED
  ON_HOLD
}

enum ContinentType {
  ASIA
  EUROPE
  NORTH_AMERICA
  SOUTH_AMERICA
  AFRICA
  AUSTRALIA
}

enum ClimateType {
  ALPINE
  CONTINENTAL
  TROPICAL
  DESERT
  POLAR
  MARINE
  TEMPERATE
}

enum ProjectCategory {
  RESIDENTIAL
  COMMERCIAL
  INSTITUTIONAL
  LANDSCAPE
  INTERIOR
  URBAN_PLANNING
  MIXED_USE
  TENANT_IMPROVEMENT
  REMODEL_ADDITION
  OTHER
}

enum AssetType {
  IMAGE_2D // Photos, renders
  DRAWING_2D // Floor plans, sections (PDF, SVG, PNG)
  DOCUMENT_1D // Specifications, contracts (PDF, DOCX)
  MODEL_3D // GLB/GLTF/USDZ
  TOUR_360 // 360° panorama or virtual tour
  VIDEO // MP4 walkthroughs, animations
}

enum ServiceType {
  NEW_CONSTRUCTION
  RENOVATION
  ADDITION
  INTERIOR_DESIGN
  LANDSCAPE_DESIGN
  OTHER
}

enum ServiceApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum RequestStatus {
  PENDING
  REVIEWED
  ACTIVE
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum MeetingType {
  INITIAL_CONSULTATION // the first call — either side may propose it
  PROJECT_KICKOFF // always set by the architect
  PHASE_PROGRESS // legacy per-phase walkthroughs
  GENERAL
}

enum MeetingStatus {
  PENDING_CLIENT_REQUEST // client proposed a time, awaiting PM response
  PENDING_RESPONSE // PM proposed a time, awaiting client response
  ACCEPTED // locked/confirmed
  DECLINED // rejected, sender may re-propose
}

enum MediaContentType {
  WORLD_PROJECT
  PORTFOLIO
  ARTICLE
  NEWS
  HOME_HERO
}

enum MediaStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum AmendmentStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum TimecardStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentType {
  LUMP_SUM
  INSTALLMENT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ──────────────────────────────────────────────────────────────
// Core Models 
// ──────────────────────────────────────────────────────────────
model User {
  id                   String             @id @default(uuid())
  email                String             @unique
  name                 String?
  googleId             String?            @unique
  avatar               String?
  role                 UserRole           @default(USER)

  // ── Profile ────────────────────────────────────────────────────────────
  // Maintained from Profile Settings. When a client starts a new project from
  // the portal these prefill the Client Information step.
  firstName     String?
  middleInitial String?
  lastName      String?
  phoneNumber   String?
  companyName   String?
  bio           String?  @db.Text
  streetAddress String?
  city          String?
  stateRegion   String?
  zipCode       String?
  country       String?

  // ── Notification preferences ───────────────────────────────────────────
  emailNotifications Boolean @default(true)
  projectUpdates     Boolean @default(true)
  securityAlerts     Boolean @default(true)

  isActive             Boolean            @default(true)
  lastLoginAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  password             String? // hashed, optional for OAuth users
  refreshToken         String?
  emailVerified        Boolean            @default(false)
  emailVerifyToken     String?            @unique // for email verification
  emailVerifyExpiry    DateTime? // token expiry
  passwordResetToken   String?            @unique // for the "forgot password" flow
  passwordResetExpiry  DateTime? // token expiry
  projects             Project[]
  assets               ProjectAsset[] // new: unified assets
  comments             Comment[]
  likes                Like[]
  employeeProfile      EmployeeProfile?
  projectRequests      ProjectRequest[]
  assignedProjects     ProjectRequest[]   @relation("AssignedProjects")
  mediaContents        MediaContent[]
  mediaAssets          MediaAsset[]
  mediaLikes           MediaLike[]
  mediaComments        MediaComment[]
  mediaCommentLikes    MediaCommentLike[]
  proposals            Proposal[]         @relation("CreatedProposals")
  assignedProposals    Proposal[]
  assignedStages       ProjectStage[]
  notification         Notification[]
  // sentMeetingLinks     MeetingLink[]      @relation("SentMeetingLinks") // meetings staff sent
  // receivedMeetingLinks MeetingLink[]      @relation("ReceivedMeetingLinks") // meetings user received
  // meetingLinks         MeetingLink[]      @relation("MeetingLinksCreatedBy")
  sentMeetingLinks     MeetingLink[]      @relation("MeetingLinksSentBy") // ← staff / sender
  receivedMeetingLinks MeetingLink[]      @relation("MeetingLinksSentTo") // ← client / receiver
  meetingLinks         MeetingLink[]      @relation("MeetingLinksCreatedBy")
  // meetingLinks         MeetingLink[]
  amendmentRequests    AmendmentRequest[]
  // amendmentRequests    AmendmentRequest[]
  // amendmentRequests    AmendmentRequest[]
  requestedAmendments  AmendmentRequest[] @relation("RequestedAmendments")
  reviewedAmendments   AmendmentRequest[] @relation("ReviewedAmendments")
  completedAmendments  AmendmentRequest[] @relation("CompletedAmendments")
  timecards            Timecard[]
  managedTeams         Team[]             @relation("ManagedTeams")
  teams                Team[]             @relation("TeamMembers")
  bankDetails          UserBankDetails?
  refundRequests       RefundRequest[]
  approvedRefunds      RefundRequest[]    @relation("ApprovedRefunds")
  payments             Payment[]
  createdAttachments   ProjectAttachment[]
  scheduleBlocks       ScheduleBlock[]     @relation("ScheduleBlockOwner")
  createdScheduleBlocks ScheduleBlock[]    @relation("ScheduleBlockCreator")

  @@index([email])
  @@index([googleId])
  @@index([role])
  @@map("users")
}

model MeetingLink {
  id               String         @id @default(uuid())
  projectRequestId String
  projectRequest   ProjectRequest @relation(fields: [projectRequestId], references: [id])

  sentToUserId String
  sentToUser   User   @relation("MeetingLinksSentTo", fields: [sentToUserId], references: [id])

  sentByUserId String
  sentByUser   User   @relation("MeetingLinksSentBy", fields: [sentByUserId], references: [id])

  meetingUrl  String?
  title       String
  // Meetings occupy a range: `scheduledAt` is the start, `endsAt` the end.
  // Rows created before ranges existed have no `endsAt` and are treated as
  // a single 30-minute slot.
  scheduledAt DateTime
  endsAt      DateTime?
  notes       String?
  emailSent   Boolean   @default(false)
  emailSentAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  status      MeetingStatus @default(PENDING_RESPONSE)
  meetingType MeetingType   @default(GENERAL)

  // Optional link to a specific project phase — null means this is the
  // overall/initial meeting, non-null means a per-phase meeting.
  stageId String?
  stage   ProjectStage? @relation(fields: [stageId], references: [id])

  // Keep this one if you really need a third relation to User
  // (but most likely you can remove it — see alternatives below)
  userId String?
  user   User?   @relation("MeetingLinksCreatedBy", fields: [userId], references: [id])

  @@index([projectRequestId])
  @@index([sentToUserId])
  @@index([sentByUserId])
  @@index([scheduledAt])
  @@index([stageId])
  @@index([status])
  @@map("meeting_links")
}

// ──────────────────────────────────────────────────────────────
// Schedule Blocks – a PM/admin marks themselves unavailable (site visit,
// vacation, out of office). Clients assigned to that manager cannot book a
// meeting inside a blocked range.
// ──────────────────────────────────────────────────────────────
model ScheduleBlock {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("ScheduleBlockOwner", fields: [userId], references: [id], onDelete: Cascade)

  title  String // e.g. "Site visit", "Vacation"
  notes  String?
  startAt DateTime
  endAt   DateTime
  allDay  Boolean @default(false)

  createdById String
  createdBy   User   @relation("ScheduleBlockCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([startAt])
  @@index([endAt])
  @@map("schedule_blocks")
}

// ──────────────────────────────────────────────────────────────
// NEW: Media Content Model (World Projects, Portfolio, Articles)
// ──────────────────────────────────────────────────────────────
model MediaContent {
  id          String           @id @default(uuid())
  contentType MediaContentType
  status      MediaStatus      @default(DRAFT)

  // Basic Info
  title   String
  slug    String  @unique
  excerpt String? @db.VarChar(500)
  content String  @db.Text

  // Media Specific Fields
  location    String? // For World Projects
  country     String?
  city        String?
  coordinates Json? // {lat, lng}

  projectYear   Int? // Completion year
  projectArea   Float? // Square footage/meters
  projectClient String?
  architect     String?
  photographer  String?

  // world project specific fields
  continent ContinentType?
  climate   ClimateType?
  

  // Portfolio specific
  category    ProjectCategory?
  projectTags String[] // e.g., ["luxury", "eco-friendly"]

  // Article specific
  author      String? // Author name (different from creator)
  publishDate DateTime?
  readTime    Int? // in minutes

  // SEO
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[]

  // Featured content
  isFeatured    Boolean @default(false)
  featuredOrder Int?

  // Cover/Thumbnail
  coverImage     String?
  thumbnailImage String?

  // Relations
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  assets MediaAsset[]
  tags   MediaContentTag[]

  likes    MediaLike[]
  comments MediaComment[]

  // Analytics
  viewCount    Int @default(0)
  likeCount    Int @default(0)
  commentCount Int @default(0)
  shareCount   Int @default(0)

  // Timestamps
  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([contentType])
  @@index([status])
  @@index([createdById])
  @@index([isFeatured])
  @@index([publishedAt])
  @@index([country])
  @@index([city])
  @@map("media_contents")
}

// ──────────────────────────────────────────────────────────────
// NEW: Media Asset Model (for media content)
// ──────────────────────────────────────────────────────────────
model MediaAsset {
  id String @id @default(uuid())

  mediaContentId String
  mediaContent   MediaContent @relation(fields: [mediaContentId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  type    AssetType
  title   String?
  caption String?
  altText String?
  order   Int       @default(0)

  // File info
  originalUrl String
  cdnUrl      String
  fileSize    Int
  mimeType    String

  // Image specific
  width    Int?
  height   Int?
  format   String?
  blurHash String?
  sizes    Json? // {thumbnail, medium, large}

  // Video specific
  streamingUrl String?
  duration     Int?
  resolution   String?
  posterUrl    String? // Video thumbnail

  // 3D Model
  modelUrl     String?
  usdzUrl      String?
  thumbnailUrl String?

  // Processing
  isProcessed   Boolean @default(false)
  processStatus String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mediaContentId])
  @@index([uploadedById])
  @@index([type])
  @@index([order])
  @@map("media_assets")
}

// ──────────────────────────────────────────────────────────────
// NEW: Media Content Tags
// ──────────────────────────────────────────────────────────────
model MediaTag {
  id        String            @id @default(uuid())
  name      String            @unique
  slug      String            @unique
  contents  MediaContentTag[]
  createdAt DateTime          @default(now())

  @@index([slug])
  @@map("media_tags")
}

model MediaContentTag {
  mediaContentId String
  tagId          String

  mediaContent MediaContent @relation(fields: [mediaContentId], references: [id], onDelete: Cascade)
  tag          MediaTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mediaContentId, tagId])
  @@map("media_content_tags")
}

model MediaLike {
  id             String   @id @default(uuid())
  userId         String
  mediaContentId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaContent MediaContent @relation(fields: [mediaContentId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaContentId]) // one like per user per media
  @@index([mediaContentId])
  @@index([userId])
  @@map("media_likes")
}

// ──────────────────────────────────────────────────────────────
// Comments for MediaContent 
// ──────────────────────────────────────────────────────────────
model MediaComment {
  id             String  @id @default(uuid())
  content        String  @db.Text
  userId         String
  mediaContentId String
  parentId       String? // for replies

  mediaContent MediaContent   @relation(fields: [mediaContentId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       MediaComment?  @relation("MediaCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      MediaComment[] @relation("MediaCommentReplies")

  isApproved Boolean            @default(true) // for moderation (articles/news)
  likeCount  Int                @default(0) // optional - denormalized
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  // mediaCommentLikes MediaCommentLike[]
  likes      MediaCommentLike[]

  @@index([mediaContentId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt(sort: Desc)])
  @@map("media_comments")
}

// Optional: Likes on Comments (very useful for articles & news)
model MediaCommentLike {
  id        String   @id @default(uuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment MediaComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("media_comment_likes")
}

//=================================project req==========================

model ProjectRequest {
  id                          String           @id @default(uuid())
  // Client Details
  clientFirstName             String
  clientMiddleName            String?
  clientLastName              String
  companyName                 String?
  email                       String
  phone                       String?
  country                     String           @default("United States")
  state                       String?
  city                        String?
  streetAddress               String?
  aptSuiteUnit                String?
  zipCode                     String?
  additionalComments          String?
  // Project Details
  projectName                 String
  projectLocationSameAsClient Boolean          @default(false)
  projectCountry              String?
  projectState                String?
  projectCity                 String?
  projectStreetAddress        String?
  projectAptSuiteUnit         String?
  projectZipCode              String?
  serviceType                 ServiceType      @default(NEW_CONSTRUCTION)
  projectCategory             ProjectCategory?
  projectSize                 String? // e.g., "2000 sq ft" or Float for area
  budgetRange                 String? // e.g., "100k-250k"
  // Architectural Preferences
  preferredArchitecturalStyle String?
  siteConstraints             String?
  // Sustainability and Special Requirements
  sustainabilityGoals         String?
  specialRequirements         String?
  // Appointment
  appointmentDate             DateTime?
  appointmentTime             String? // e.g., "10:00 AM"
  appointmentType             String? // e.g., "Initial Consultation"
  additionalNotes             String?
  consultationPaymentId       String? // Stripe PaymentIntent ID for the $250 fee
  driveLink                   String?  // Google Drive link for internal project files
  // meetingLinks                MeetingLink[]
  stages                      ProjectStage[]

  // Assets

  // New Inquiry flag (PM-created inquiries for outside clients)
  isNewInquiry              Boolean          @default(false)
  isApproved                Boolean          @default(false) // Client requests need approval
  isArchived                Boolean          @default(false)
  archiverId                String?
  archivedAt                DateTime?

  // Assigned Project Manager (only SUPER_ADMIN can assign)
  assignedManagerId String?
  assignedManager   User?          @relation("AssignedProjects", fields: [assignedManagerId], references: [id])

  // Status and Relations
  status       RequestStatus  @default(PENDING)
  userId       String? // Optional link to registered user
  user         User?          @relation(fields: [userId], references: [id])
  assets       ProjectAsset[] // Uploaded documents/photos
  // Timestamps
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  proposals    Proposal[]
  meetingLinks MeetingLink[]
  teams                Team[]             @relation("ProjectTeams")
  isProjectStarted     Boolean            @default(false)
  projectStartedAt     DateTime?
  projectCompletedAt   DateTime?
  totalDurationMonths  Float?
  refundRequests       RefundRequest[]
  payments             Payment[]
  attachments          ProjectAttachment[]

  @@index([email])
  @@index([status])
  @@index([deletedAt])
  @@index([userId])
  @@index([createdAt])
  @@index([isArchived])
  @@index([assignedManagerId])
  @@map("project_requests")
}

model ProjectAttachment {
  id               String         @id @default(uuid())
  projectRequestId String
  projectRequest   ProjectRequest @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)

  title String
  url   String

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectRequestId])
  @@map("project_attachments")
}

model Proposal {
  id String @id @default(uuid())

  // Links
  projectRequestId String
  projectRequest   ProjectRequest @relation(fields: [projectRequestId], references: [id])

  userId String? // The client this proposal is for
  user   User?   @relation(fields: [userId], references: [id])

  proposalNumber String  @unique
  title          String
  subject        String?

  // Client Info (can differ from user)
  clientName    String
  clientEmail   String
  clientPhone   String?
  clientCompany String?

  // Project Details
  projectName        String
  projectLocation    String
  projectDescription String? @db.Text
  additionalContext  String? @db.Text

  // Specifications
  serviceType      ServiceType
  projectCategory  ProjectCategory?
  squareFootage    String?
  budgetRange      String?
  expectedTimeline String? // e.g., "3-6 months"

  // Status
  status      ProposalStatus @default(DRAFT)
  sentAt      DateTime?
  viewedAt    DateTime?
  respondedAt DateTime?
  expiresAt   DateTime?

  // Services
  services ProposalService[]

  // Financials
  subtotal    Decimal  @default(0) @db.Decimal(10, 2)
  taxRate     Decimal? @db.Decimal(5, 2)
  taxAmount   Decimal? @db.Decimal(10, 2)
  totalAmount Decimal  @default(0) @db.Decimal(10, 2)

  // Credits/Discounts
  credits ProposalCredit[]

  // Payment
  paymentMethod String? // "LUMP_SUM" or "INSTALLMENT"
  paymentType   PaymentType? // Formal enum for payment gating
  paymentTerms  String? @db.Text

  // Schedule & Contact
  estimatedDuration String?
  contactInfo       String? @db.Text

  // Signatures
  ownerSignature String?
  ownerSignedAt  DateTime?
  ownerSignedBy  String?

  architectSignature String?
  architectSignedAt  DateTime?
  architectSignedBy  String? // "Eric Rivera, AIA"

  // Additional
  notes              String? @db.Text
  termsAndConditions String? @db.Text

  // Contract data - snapshot of master contract sections when proposal is sent
  contractSections         Json?     // JSON array of contract article sections
  architectContractSignature String?  @db.Text // base64 canvas signature from architect
  clientContractSignature    String?  @db.Text // base64 canvas signature from client
  clientContractSignedAt     DateTime?

  // Metadata
  createdById String
  createdBy   User   @relation("CreatedProposals", fields: [createdById], references: [id])

  // If accepted, link to actual project stages
  projectStages ProjectStage[]

  projectId String?  @unique
  project   Project?

  proposalType     ProposalType @default(NORMAL)
  parentProposalId String?
  parentProposal   Proposal?    @relation("ProposalAmendments", fields: [parentProposalId], references: [id], onDelete: SetNull)
  amendments       Proposal[]   @relation("ProposalAmendments")

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  
  amendmentRequests AmendmentRequest[]
  linkedAmendment   AmendmentRequest?  @relation("AmendmentProposalLink")
  // amendmentRequest  AmendmentRequest?

  @@index([userId])
  @@index([proposalNumber])
  @@index([parentProposalId])
  @@index([proposalType])
  @@index([status])
  @@index([projectRequestId])
  @@map("proposals")
}

model AmendmentRequest {
  id         String   @id @default(uuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  // Request Details
  projectName String
  description String @db.Text

  // Client-supplied scope estimate for the requested extension
  squareFootage   String? // numeric portion, e.g. "1200"
  projectSizeUnit String? // "sqf" | "sqm"
  budgetRange     String?

  // Legacy intake fields — no longer collected from the client form
  services String? @db.Text
  urgency  String? // "LOW", "MEDIUM", "HIGH", "URGENT"

  // Status
  status AmendmentStatus @default(PENDING)

  // Client Info
  requestedById String?
  requestedBy   User?   @relation("RequestedAmendments", fields: [requestedById], references: [id])

  // PM Response
  reviewedById String?
  reviewedBy   User?     @relation("ReviewedAmendments", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNotes  String?   @db.Text

  // Amendment Proposal (if created)
  amendmentProposalId String?   @unique
  amendmentProposal   Proposal? @relation("AmendmentProposalLink", fields: [amendmentProposalId], references: [id], onDelete: SetNull)

  // Completion
  completedAt   DateTime?
  completedBy   String?
  completedById User?     @relation("CompletedAmendments", fields: [completedBy], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@index([proposalId])
  @@index([status])
  @@index([requestedById])
  @@map("amendment_requests")
  @@index([userId])
}

model ProposalService {
  id         String   @id @default(uuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  name          String // e.g., "Assemble Information"
  description   String? @db.Text
  order         Int     @default(0)
  timelineWeeks Int? // add if needed
  active        Boolean @default(true)

  // Pricing
  rate     Decimal? @db.Decimal(10, 2)
  quantity Int      @default(1)
  unit     String? // "weeks", "hours", "sq ft"
  amount   Decimal  @db.Decimal(10, 2)

  approvalStatus   ServiceApprovalStatus @default(PENDING_APPROVAL)
  requiresApproval Boolean               @default(false)
  approvedAt       DateTime?
  approvedBy       String?
  rejectedAt       DateTime?
  rejectedBy       String?
  rejectionReason  String?               @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([proposalId])
  @@index([order])
  @@index([approvalStatus])
  @@map("proposal_services")
}

model ProposalCredit {
  id         String   @id @default(uuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  type        String // "DOLLAR_AMOUNT" or "PERCENTAGE"
  amount      Decimal @db.Decimal(10, 2)
  description String? @db.Text

  createdAt DateTime @default(now())

  @@index([proposalId])
  @@map("proposal_credits")
}

model ProjectStage {
  id String @id @default(uuid())

  // Links
  proposalId String?
  proposal   Proposal? @relation(fields: [proposalId], references: [id])

  // Stage Info
  name        String // "Schematic Design", "Design Development", etc.
  description String? @db.Text
  order       Int     @default(0)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Progress
  status   StageStatus @default(NOT_STARTED)
  progress Int         @default(0) // 0-100

  // Tasks
  totalTasks     Int @default(0)
  completedTasks Int @default(0)

  // Timeline
  startDate   DateTime?
  dueDate     DateTime?

  // Deadlines
  internalDeadline DateTime?
  externalDeadline DateTime?
  completedAt DateTime?

  // Assignment
  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  // Tracking
  notes String? @db.Text
  driveLink String? // Optional Google Drive link for deliverables

  // Phase progress meeting: once the PM completes the phase (and the client has
  // paid it, on an installment plan) the client may book a walkthrough call.
  // The PM can turn the requirement off per phase; the client can also opt out.
  meetingRequired      Boolean @default(true)
  clientBypassedMeeting Boolean @default(false)

  // Timer tracking for phase time
  activeTimerStart DateTime? // when timer was last started
  accumulatedTime  Int       @default(0) // total seconds accumulated
  timerUserId      String?   // who started the timer

  // Metadata
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  projectRequest   ProjectRequest? @relation(fields: [projectRequestId], references: [id])
  projectRequestId String?

  deadlineReminders DeadlineReminder[]
  meetingLinks      MeetingLink[]

  @@index([proposalId])
  @@index([status])
  @@index([assignedToId])
  @@map("project_stages")
}

// ──────────────────────────────────────────────────────────────
// Deadline Reminders – scheduled notifications for deadlines
// ──────────────────────────────────────────────────────────────
model DeadlineReminder {
  id String @id @default(uuid())

  // Link to stage
  stageId String
  stage   ProjectStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  // Which deadline this reminder is for
  deadlineType  String // "INTERNAL" or "EXTERNAL"
  deadlineDate  DateTime // The actual deadline date
  reminderDate  DateTime // When the reminder should fire (7/3/1 day before)
  daysBefore    Int      // 7, 3, or 1

  // Target user for the notification
  targetUserId String

  // Status tracking
  sentAt    DateTime? // null = not yet sent
  cancelled Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stageId])
  @@index([reminderDate])
  @@index([sentAt])
  @@index([cancelled])
  @@map("deadline_reminders")
}

//===========notification========
model Notification {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String // NEW_PROJECT_REQUEST, STATUS_UPDATED, etc.
  title            String
  message          String
  link             String?
  isRead           Boolean  @default(false)
  projectRequestId String?  // Link to project request for accept/reject
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([projectRequestId])
}

