// ──────────────────────────────────────────────────────────────
// Timecards – weekly timesheet per employee
// ──────────────────────────────────────────────────────────────
model Timecard {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStarting  DateTime       @default(now()) // Start of the bi-weekly pay period (Monday)
  weekEnding    DateTime       // End of the bi-weekly pay period (Sunday +13 days)
  payPeriod     Int            @default(1) // 1-26 bi-weekly pay periods per year
  payYear       Int            @default(2026) // year of the pay period
  status        TimecardStatus @default(DRAFT)
  billableHours    Decimal        @default(0) @db.Decimal(6, 2)
  nonBillableHours Decimal        @default(0) @db.Decimal(6, 2)
  totalHours       Decimal        @default(0) @db.Decimal(6, 2)
  totalCost     Decimal        @default(0) @db.Decimal(10, 2)
  submittedAt   DateTime?
  approvedAt    DateTime?
  approvedBy    String?
  rejectedAt    DateTime?
  rejectedBy    String?
  rejectionNote String?
  // Accountants archive approved timecards once payroll has been processed.
  isArchived    Boolean        @default(false)
  archivedAt    DateTime?
  archivedBy    String?
  entries         TimecardEntry[]
  billableEntries TimecardBillableEntry[]
  createdAt       DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([userId, weekStarting])
  @@index([userId])
  @@index([status])
  @@index([weekEnding])
  @@index([payPeriod, payYear])
  @@index([isArchived])
  @@map("timecards")
}

model TimecardEntry {
  id          String   @id @default(uuid())
  timecardId  String
  timecard    Timecard @relation(fields: [timecardId], references: [id], onDelete: Cascade)
  
  // Overhead category (Bereavement, Holiday, Sick, etc.)
  category    String
  
  // Optional association with a project/phase for direct overhead tracking
  projectRequestId String?
  phaseName        String?

  entryWeek   Int      @default(1)
  
  monday      Decimal  @default(0) @db.Decimal(4, 2)
  tuesday     Decimal  @default(0) @db.Decimal(4, 2)
  wednesday   Decimal  @default(0) @db.Decimal(4, 2)
  thursday    Decimal  @default(0) @db.Decimal(4, 2)
  friday      Decimal  @default(0) @db.Decimal(4, 2)
  saturday    Decimal  @default(0) @db.Decimal(4, 2)
  sunday      Decimal  @default(0) @db.Decimal(4, 2)
  totalHours  Decimal  @default(0) @db.Decimal(6, 2)

  @@index([timecardId])
  @@index([projectRequestId])
  @@map("timecard_entries")
}

// ──────────────────────────────────────────────────────────────
// Timecard Billable Entries – per-project/per-phase time tracking
// ──────────────────────────────────────────────────────────────
model TimecardBillableEntry {
  id               String   @id @default(uuid())
  timecardId       String
  timecard         Timecard @relation(fields: [timecardId], references: [id], onDelete: Cascade)
  projectRequestId String   // which project
  projectName      String   // cached project name
  phaseName        String   // phase name
  description      String?  @db.Text
  entryWeek        Int      @default(1) // 1 = Week 1, 2 = Week 2 of bi-weekly period

  // Billable hours (per day)
  monday           Decimal  @default(0) @db.Decimal(4, 2)
  tuesday          Decimal  @default(0) @db.Decimal(4, 2)
  wednesday        Decimal  @default(0) @db.Decimal(4, 2)
  thursday         Decimal  @default(0) @db.Decimal(4, 2)
  friday           Decimal  @default(0) @db.Decimal(4, 2)
  saturday         Decimal  @default(0) @db.Decimal(4, 2)
  sunday           Decimal  @default(0) @db.Decimal(4, 2)
  totalHours       Decimal  @default(0) @db.Decimal(6, 2)

  @@index([timecardId])
  @@index([projectRequestId])
  @@map("timecard_billable_entries")
}
model Team {
  id           String           @id @default(uuid())
  name         String
  createdById  String
  createdBy    User             @relation("ManagedTeams", fields: [createdById], references: [id])
  members      User[]           @relation("TeamMembers")
  projects     ProjectRequest[] @relation("ProjectTeams")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("teams")
}

// ──────────────────────────────────────────────────────────────
// User Bank Details – for refund payments
// ──────────────────────────────────────────────────────────────
model UserBankDetails {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  bankName      String
  accountNumber String
  routingNumber String
  branchName    String?
  bankType      String?  // "TRADITIONAL", "ONLINE", "CREDIT_UNION", "MOBILE_BANK"

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("user_bank_details")
}

// ──────────────────────────────────────────────────────────────
// Refund Requests – client can request refund after phase completion
// ──────────────────────────────────────────────────────────────
model RefundRequest {
  id                String       @id @default(uuid())

  // Who requested
  userId            String
  user              User         @relation(fields: [userId], references: [id])

  // Which project/phase
  projectRequestId  String
  projectRequest    ProjectRequest @relation(fields: [projectRequestId], references: [id])
  stageId           String
  stageName         String       // cached for display

  // Refund details
  refundName        String       // e.g., "Refund for Schematic Design"
  refundDescription String       @db.Text
  refundCause       String
  amount            Decimal      @db.Decimal(10, 2)

  // Status
  refundStatus      RefundStatus @default(PENDING)

  // Approval
  approvedById      String?
  approvedBy        User?        @relation("ApprovedRefunds", fields: [approvedById], references: [id])
  approvedAt        DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?

  // Set when the accountant confirms the money actually left the bank.
  // Until then, approved refunds trigger a daily reminder notification.
  refundProcessedAt DateTime?
  refundProcessedBy String?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([userId])
  @@index([projectRequestId])
  @@index([refundStatus])
  @@map("refund_requests")
}

// ──────────────────────────────────────────────────────────────
// Payments – Stripe payments for project phases
// ──────────────────────────────────────────────────────────────
model Payment {
  id                    String        @id @default(uuid())

  // Who paid
  userId                String
  user                  User          @relation(fields: [userId], references: [id])

  // Which project
  projectRequestId      String
  projectRequest        ProjectRequest @relation(fields: [projectRequestId], references: [id])
  proposalId            String

  // For installment: which phase this payment covers
  stageId               String?       // null for lump sum
  stageName             String?       // cached

  // Payment details
  amount                Decimal       @db.Decimal(10, 2)
  paymentType           PaymentType   // LUMP_SUM or INSTALLMENT
  paymentStatus         PaymentStatus @default(PENDING)

  // Stripe
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?       @unique

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([userId])
  @@index([projectRequestId])
  @@index([paymentStatus])
  @@map("payments")
}
